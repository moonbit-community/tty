import {
  "moonbitlang/async",
  "moonbitlang/async/types" @async/types,
  "moonbitlang/async/fs" @async/fs,
  "moonbitlang/async/pipe" @async/pipe,
  "moonbitlang/async/process" @async/process,
  "moonbitlang/async/socket" @async/socket,
  "moonbitlang/async/stdio" @async/stdio,
  "moonbitlang/async/os_error",
  "moonbitlang/async/io" @async/io,
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbit-community/tty/color",
  "moonbit-community/tty/input" @public_input,
  "moonbit-community/tty/internal/lock",
  "moonbit-community/tty/internal/input",
  "moonbit-community/tty/internal/sidecar",
  "moonbit-community/tty/internal/win32",
  "moonbit-community/tty/internal/vt",
}

import {
  "moonbitlang/async",
  "moonbitlang/async/pipe" @async/pipe,
  "moonbitlang/async/stdio" @async/stdio,
  "moonbitlang/core/debug",
  "moonbit-community/tty/color",
  "moonbit-community/tty/input" @public_input,
} for "test"

import {
  "moonbitlang/async",
  "moonbitlang/core/debug",
} for "wbtest"

supported_targets = "native+wasm"

options(
  "native-stub": [ "isatty.c", "state.c", "size.c", "resize.c" ],
  targets: {
    "isatty.mbt": [ "native" ],
    "state.mbt": [ "native" ],
    "size.mbt": [ "native" ],
    "resize_unix.mbt": [ "native" ],
    "resize_win32.mbt": [ "native" ],
    "win32_input.mbt": [ "native" ],
    "non_windows_imports.mbt": [ "native" ],
    "sidecar_imports.mbt": [ "native" ],
    "tty_native.mbt": [ "native" ],
    "tty_test.mbt": [ "native" ],
    "tty_shared_test.mbt": [ "native", "wasm" ],
    "isatty_test.mbt": [ "native" ],
    "tty_wbtest.mbt": [ "native" ],
    "pkg.generated.mbti": [ "native" ],
    "sidecar_wasm.mbt": [ "wasm" ],
    "sidecar_binaries_wasm.mbt": [ "wasm" ],
    "tty_wasm.mbt": [ "wasm" ],
    "isatty_wasm.mbt": [ "wasm" ],
    "state_wasm.mbt": [ "wasm" ],
    "size_wasm.mbt": [ "wasm" ],
  },
)
