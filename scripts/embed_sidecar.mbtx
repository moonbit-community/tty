///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
}

///|
/// Regenerate `internal/sidecar/sidecars.generated.mbt` from built sidecar
/// executables. The `sidecars` GitHub workflow runs this on `main`.
///
///   moon run --target native scripts/embed_sidecar.mbtx -- KEY=PATH ...
///
/// KEY is `<os>-<arch>` as produced by `internal/sidecar`, for example
/// `macos-arm64` or `linux-x86_64`. Run it from the repository root; with
/// no arguments the table is reset to empty.
const OUTPUT : String = "internal/sidecar/sidecars.generated.mbt"

///|
async fn main {
  let entries : Array[(String, Bytes)] = []
  for arg in @env.args()[1:] {
    guard arg.split("=").collect() is [key, path] else {
      fail("expected KEY=PATH, got \{arg}")
    }
    entries.push((key.to_owned(), @fs.read_file(path.to_owned()).binary()))
  }
  let out = StringBuilder::new()
  out.write_string(
    #|///|
    #|/// Sidecar executables keyed by `<os>-<arch>`. Generated by
    #|/// `scripts/embed_sidecar.mbtx`; do not edit by hand.
    #|let embedded_sidecars : Map[String, Bytes] =
    ,
  )
  if entries.is_empty() {
    out.write_string(" Map([])\n")
  } else {
    out.write_string(" {\n")
    for entry in entries {
      let (key, executable) = entry
      out.write_string("  \"\{key}\": (\n")
      write_literal(out, executable)
      out.write_string("  ),\n")
    }
    out.write_string("}\n")
  }
  @fs.write_file(OUTPUT, out.to_string())
}

///|
/// The executable as `b"..."` literals of 64 bytes joined with `+`, one per
/// line, which keeps every line short enough for the compiler.
fn write_literal(out : StringBuilder, data : Bytes) -> Unit {
  let chunks = (data.length() + 63) / 64
  for i in 0..<chunks {
    out.write_string("    b\"")
    for b in data[i * 64:@cmp.minimum((i + 1) * 64, data.length())] {
      out.write_string("\\x")
      out.write_char(hex_digit(b.to_int() >> 4))
      out.write_char(hex_digit(b.to_int() & 0xf))
    }
    out.write_string(if i + 1 < chunks { "\" +\n" } else { "\"\n" })
  }
}

///|
fn hex_digit(d : Int) -> Char {
  if d < 10 {
    Char::from_int(0x30 + d)
  } else {
    Char::from_int(0x61 + d - 10)
  }
}
