///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/cmp",
  "moonbitlang/core/env",
}

///|
/// Regenerate `internal/sidecar/sidecars.generated.mbt` from the sidecar
/// executables that the `sidecars` GitHub workflow built. Run from the
/// repository root:
///
///   moon run --target native scripts/ci_sidecars.mbtx -- [DIR]
///
/// DIR defaults to `dist` and holds one `sidecar-<os>-<arch>` directory per
/// platform, each with the executable inside, which is how
/// `actions/download-artifact` lays artifacts out. `--reset` writes an empty
/// table instead.
const OUTPUT : String = "internal/sidecar/sidecars.generated.mbt"

///|
const ARTIFACT_PREFIX : String = "sidecar-"

///|
/// 128 bytes make a line of about 770 columns and keep the largest
/// executable well under the compiler's per-segment line limit.
const BYTES_PER_LINE : Int = 128

///|
async fn main {
  let entries : Array[(String, Bytes)] = []
  match @env.args()[1:] {
    ["--reset"] => ()
    [] => collect(entries, "dist")
    [dir] => collect(entries, dir)
    _ => fail("usage: ci_sidecars.mbtx [DIR | --reset]")
  }
  let header =
    #|///|
    #|/// Sidecar executables keyed by `<os>-<arch>`. Generated by
    #|/// `scripts/ci_sidecars.mbtx`; do not edit by hand.
    #|let embedded_sidecars : Map[String, Bytes] =
  let out = StringBuilder()
  out.write_string(header)
  if entries.is_empty() {
    out.write_string(" Map([])\n")
  } else {
    out.write_string(" {\n")
    for entry in entries {
      let (key, _) = entry
      out.write_string("  \"\{key}\": \{binding_name(key)},\n")
    }
    out.write_string("}\n")
    for entry in entries {
      let (key, executable) = entry
      out.write_string("\n///|\nlet \{binding_name(key)} : Bytes = [\n")
      write_literal(out, executable)
      out.write_string("]\n")
    }
  }
  @fs.write_file(OUTPUT, out.to_string())
}

///|
/// Every `sidecar-<key>/<executable>` under `dir`, in a fixed order so the
/// generated file is the same whatever order the artifacts arrived in.
async fn collect(entries : Array[(String, Bytes)], dir : String) -> Unit {
  let names = @fs.readdir(dir)
  names.sort()
  for name in names {
    guard name.has_prefix(ARTIFACT_PREFIX) else { continue }
    let key = name[ARTIFACT_PREFIX.length():].to_owned()
    guard @fs.readdir("\{dir}/\{name}") is [file] else {
      fail("expected exactly one executable in \{dir}/\{name}")
    }
    entries.push((key, @fs.read_file("\{dir}/\{name}/\{file}").binary()))
  }
  guard !entries.is_empty() else { fail("no \{ARTIFACT_PREFIX}* directories in \{dir}") }
}

///|
/// The top-level binding holding the executable for `key`, such as
/// `sidecar_linux_x86_64`. Each executable gets its own `///|` segment
/// because the compiler limits how many lines one segment may span.
fn binding_name(key : String) -> String {
  "sidecar_" + key.replace_all(old="-", new="_")
}

///|
/// The executable as array-literal elements, `BYTES_PER_LINE` to a line.
/// The native backend emits a `Bytes` array literal as one static block,
/// where `b"..." + b"..."` would be concatenated at program start.
fn write_literal(out : StringBuilder, data : Bytes) -> Unit {
  for start = 0; start < data.length(); start = start + BYTES_PER_LINE {
    out.write_string(" ")
    for b in data[start:@cmp.minimum(start + BYTES_PER_LINE, data.length())] {
      out.write_string(" 0x\{b.to_hex()},")
    }
    out.write_string("\n")
  }
}
